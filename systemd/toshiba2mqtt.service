[Unit]
Description=Toshiba AC to MQTT bridge
After=network-online.target mosquitto.service
Wants=network-online.target

[Service]
Type=simple
# Adjust User/paths to your setup
User=toshiba2mqtt
WorkingDirectory=/opt/toshiba2mqtt
ExecStart=/opt/toshiba2mqtt/.venv/bin/python /opt/toshiba2mqtt/toshiba2mqtt.py --config /opt/toshiba2mqtt/config.yaml
Restart=on-failure
RestartSec=10
# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/toshiba2mqtt

[Install]
WantedBy=multi-user.target
